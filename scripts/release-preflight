#!/usr/bin/env bash
set -euo pipefail

# Release preflight (read-only) for the tag-driven npm + GitHub Release
# pipeline. Validates the tagged commit before any publication work and runs
# the full CI gate set — the release must not start from a red tree or a
# duplicate version. Fails closed: any failing check stops the release.
#
# Curated release notes contract (single current release document):
#   docs/releases/ holds exactly ONE markdown file — the current release
#   document, named docs/releases/<tag>.md. A new release renames the previous
#   document (git mv docs/releases/<old-tag>.md docs/releases/<new-tag>.md),
#   replaces its content with the curated narrative body, bumps the package,
#   commits, and then tags. The release template lives in the
#   ci-cd-and-automation skill assets only — never as docs/releases/TEMPLATE.md.
#   Preflight fails the release when docs/releases has zero or multiple
#   documents, when the document name does not match RELEASE_TAG, or when the
#   body is empty, placeholder-filled, or malformed (missing required
#   sections or a title that does not match the tag).
#
# Context (provided by .github/workflows/release.yml):
#   RELEASE_TAG / RELEASE_COMMIT / RELEASE_REPOSITORY
# Standalone use: set RELEASE_TAG (and RELEASE_REPOSITORY) for a local dry run.

PACKAGE_NAME="opencode-tokenmeter-tui"

: "${RELEASE_TAG:?release-preflight: RELEASE_TAG is required (e.g. v1.2.3)}"
: "${RELEASE_REPOSITORY:?release-preflight: RELEASE_REPOSITORY is required (owner/repo)}"

if [[ ! "$RELEASE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "::error::release-preflight: RELEASE_TAG must be a stable vX.Y.Z tag (got ${RELEASE_TAG})"
  exit 1
fi

VERSION="${RELEASE_TAG#v}"
PKG_VERSION="$(jq -r .version package.json)"
if [[ "$VERSION" != "$PKG_VERSION" ]]; then
  echo "::error::release-preflight: package.json version (${PKG_VERSION}) does not match RELEASE_TAG (${VERSION}) — bump package.json before tagging"
  exit 1
fi

echo "::group::release-preflight: curated release notes"
NOTES_DIR="docs/releases"
shopt -s nullglob
NOTES_CANDIDATES=("$NOTES_DIR"/*.md)
if (( ${#NOTES_CANDIDATES[@]} == 0 )); then
  echo "::error::release-preflight: no release document in ${NOTES_DIR}/ — the current release document (docs/releases/<tag>.md) must exist at the tagged commit"
  exit 1
fi
if (( ${#NOTES_CANDIDATES[@]} > 1 )); then
  echo "::error::release-preflight: expected exactly one release document in ${NOTES_DIR}/ but found:"
  printf '%s\n' "${NOTES_CANDIDATES[@]}" | sed 's/^/  /'
  echo "  — docs/releases keeps exactly ONE current document: git mv docs/releases/<old-tag>.md docs/releases/${RELEASE_TAG}.md, replace its content, then tag"
  exit 1
fi
NOTES_FILE="${NOTES_CANDIDATES[0]}"
if [[ "$(basename "$NOTES_FILE")" != "${RELEASE_TAG}.md" ]]; then
  echo "::error::release-preflight: release document must be docs/releases/${RELEASE_TAG}.md (found: ${NOTES_FILE}) — git mv the previous release document to the new tag name and replace its content"
  exit 1
fi
if [[ ! -s "$NOTES_FILE" ]]; then
  echo "::error::release-preflight: curated release notes empty: ${NOTES_FILE}"
  exit 1
fi
NOTES_H1="$(grep -m1 -E '^# ' "$NOTES_FILE" || true)"
if [[ "$NOTES_H1" != "# v${VERSION}" && "$NOTES_H1" != "# v${VERSION} "* ]]; then
  echo "::error::release-preflight: release notes H1 must title the release '# v${VERSION} ...' (got: ${NOTES_H1:-<no H1>})"
  exit 1
fi
if ! grep -qE '^## What changed' "$NOTES_FILE"; then
  echo "::error::release-preflight: release notes must include a '## What changed' narrative section"
  exit 1
fi
if ! grep -qE '^## (Upgrade|Install)' "$NOTES_FILE"; then
  echo "::error::release-preflight: release notes must include an '## Upgrade' or '## Install' section"
  exit 1
fi
NOTES_PLACEHOLDER_RE='PLACEHOLDER|TODO|FIXME|TBD|Lorem ipsum|<short narrative title>|<Change or theme>|\{\{|\}\}'
if grep -nE "$NOTES_PLACEHOLDER_RE" "$NOTES_FILE" >/dev/null; then
  echo "::error::release-preflight: release notes contain unfilled placeholder or draft markers:"
  grep -nE "$NOTES_PLACEHOLDER_RE" "$NOTES_FILE" | sed 's/^/  /'
  exit 1
fi
shopt -u nullglob
echo "release notes: ${NOTES_FILE} — curated narrative for v${VERSION}"
echo "::endgroup::"

echo "::group::release-preflight: gates"
bun install --frozen-lockfile
bun run typecheck
bun run coverage
bun run build
bun run test:dist
bun run audit
bun run pack:dry-run
bun run biome:check
echo "::endgroup::"

echo "::group::release-preflight: registry and release state"
if npm view "${PACKAGE_NAME}@${VERSION}" version >/dev/null 2>&1; then
  echo "::error::release-preflight: ${PACKAGE_NAME}@${VERSION} is already published on npm — cut a new version"
  exit 1
fi
if gh release view "$RELEASE_TAG" --repo "$RELEASE_REPOSITORY" >/dev/null 2>&1; then
  echo "::error::release-preflight: GitHub Release ${RELEASE_TAG} already exists for ${RELEASE_REPOSITORY}"
  exit 1
fi
echo "::endgroup::"

echo "release-preflight: OK"
echo "  tag:        ${RELEASE_TAG}"
echo "  version:    ${VERSION}"
echo "  commit:     ${RELEASE_COMMIT}"
echo "  repository: ${RELEASE_REPOSITORY}"
echo "  notes:      ${NOTES_FILE} (curated, validated)"
echo "  npm:        https://registry.npmjs.org/${PACKAGE_NAME}/${VERSION} (will be created)"
echo "  release:    https://github.com/${RELEASE_REPOSITORY}/releases/tag/${RELEASE_TAG} (will be created)"
