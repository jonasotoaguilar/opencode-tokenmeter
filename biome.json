{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off"
      },
      "correctness": {
        "noUnusedImports": "off",
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "test/openai-cost-remote.test.ts"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "test/browser-session-source.test.ts"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "test/browser-project-detail.test.ts"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "test/durable-paths.test.ts"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
