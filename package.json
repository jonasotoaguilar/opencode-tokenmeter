{
  "name": "opencode-tokenmeter-tui",
  "version": "1.0.0",
  "description": "OpenCode TUI plugin: TokenMeter sidebar — live token usage, cost, and delegation tree for sessions",
  "type": "module",
  "main": "./dist/tokenmeter.js",
  "files": ["dist"],
  "keywords": ["opencode", "opencode-plugin", "plugin", "tokenmeter", "tui"],
  "license": "MIT",
  "author": "jonasotoaguilar",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonasotoaguilar/opencode-tokenmeter.git"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.50 <2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@opencode-ai/plugin": "^1.18.14",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "lefthook": "2.1.10",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text --path-ignore-patterns=\"test/artifact.test.ts\"",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "bun test",
    "test:dist": "bun run build && bun test test/artifact.test.ts",
    "audit": "bun audit",
    "biome:check": "biome check src test scripts tsconfig.json tsconfig.test.json",
    "biome:format": "biome format --write src test scripts tsconfig.json tsconfig.test.json",
    "hooks:install": "lefthook install",
    "pack:dry-run": "bun pm pack --dry-run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "@babel/core": "^7.29.7"
  }
}
